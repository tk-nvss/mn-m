{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/games/page.jsx", "components/Header/Header.jsx", "app/owner-panal/page.jsx", "app/blog/page.jsx", "components/Home/TrustHighlights.tsx", "app/admin-panal/page.jsx", "app/login/page.jsx", "app/terms-and-conditions/page.jsx", "app/privacy-policy/page.jsx"  ],
  "exclude": ["node_modules"]
}
